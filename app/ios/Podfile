platform :ios, '15.0'

# This file is generated by Flutter during 'flutter pub get'
# Even if it's missing on your Windows machine, Codemagic will have it.
podhelper_path = File.join(File.dirname(File.realpath(__FILE__)), 'Flutter', 'generated_podhelper.rb')
require podhelper_path if File.exist?(podhelper_path)

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # Force 15.0 for all plugin targets to match our platform
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
